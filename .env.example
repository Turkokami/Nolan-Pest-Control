# Public site URL (used for canonical URLs, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://nolanpestcontrol.com

# ---------------------------------------------------------------------------
# Quote-form delivery — REQUIRED for the contact form to work.
#
# /api/quote needs at least one of these. With neither set, the form returns a
# 503 and tells the visitor to call, which is deliberate: it must never show a
# thank-you for a lead it did not deliver.
#
# 1) Resend (recommended). Create a key at resend.com, add it in Vercel under
#    Settings -> Environment Variables. Free tier covers this volume easily.
RESEND_API_KEY=

#    Optional. Until nolanpestcontrol.com is verified as a sending domain in
#    Resend, leave this blank and mail goes out via onboarding@resend.dev.
#    After verifying the domain, set it for better deliverability, e.g.
#    QUOTE_FORM_FROM="Nolan Pest Control Website <leads@nolanpestcontrol.com>"
QUOTE_FORM_FROM=

# 2) Or POST the lead as JSON to a CRM / Zapier / Make webhook instead of or in
#    addition to email. If both are configured, both run.
QUOTE_FORM_WEBHOOK_URL=
# ---------------------------------------------------------------------------

# Google Business Profile / reviews (Phase 5 — real reviews only)
# GOOGLE_PLACE_ID=
